/></Array></mxGeometry></mxCell><mxCell id="r43" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#374151;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t25" target="t27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r44" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#374151;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t26" target="t28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r45" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#374151;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t28" target="t29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r46" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#374151;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="t23" target="t24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lg47" value="&lt;b&gt;Convenções&lt;/b&gt;&lt;br/&gt;&lt;span style='background:#B45309;color:#fff;padding:0 3px;font-size:8px;border-radius:3px'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/span&gt; chave primária &amp;nbsp; &lt;span style='background:#1D4ED8;color:#fff;padding:0 3px;font-size:8px;border-radius:3px'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/span&gt; chave estrangeira (→ tabela de destino)&lt;br/&gt;NN = NOT NULL · UQ = UNIQUE · now() = valor padrão&lt;br/&gt;Enums do Java gravados como &lt;b&gt;varchar + CHECK&lt;/b&gt; (JPA EnumType.STRING)&lt;br/&gt;As linhas mostram as relações principais; toda FK indica o destino na própria coluna.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Cardinalidade (pé de galinha)&lt;/b&gt;&lt;br/&gt;┼ exatamente um · ○┼ zero ou um · ○&amp;lt; zero ou muitos · ┼&amp;lt; um ou muitos" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#F9FAFB;strokeColor=#6B7280;spacing=10;fontColor=#374151;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1320" y="180" width="740" height="150" as="geometry"/></mxCell><mxCell id="in48" value="&lt;b&gt;Banco&lt;/b&gt;: PostgreSQL 17 + PostGIS 3.5 (imagem postgis/postgis:17-3.5)&lt;br/&gt;&lt;b&gt;Migrações&lt;/b&gt;: Flyway em backend/src/main/resources/db/migration&lt;br/&gt;&lt;b&gt;Chaves&lt;/b&gt;: UUID gerado pela aplicação · datas em timestamptz (UTC)&lt;br/&gt;&lt;b&gt;LGPD&lt;/b&gt;: CPF só como HMAC-SHA256 com chave secreta; documento e selfie ficam no fornecedor&lt;br/&gt;&lt;b&gt;Exclusão de conta&lt;/b&gt;: anonimização, nunca DELETE; nenhuma FK em cascata (decisoes.md, D-03)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#F9FAFB;strokeColor=#6B7280;spacing=10;fontColor=#374151;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1320" y="402" width="740" height="104" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
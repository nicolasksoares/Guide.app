# Modelo de configuração local. Copie para .env e preencha:
#   cp .env.example .env
# O .env é ignorado pelo git: segredos reais ficam SÓ nele, nunca neste arquivo.

# Banco de dados (docker-compose e API)
DB_NAME=guide
DB_USER=guide
DB_PASSWORD=troque-esta-senha
# Porta do banco no seu computador (dentro do Docker continua 5432)
DB_PORTA_HOST=5433

# Próximos segredos (ainda não usados; entram com o módulo conta e o pagamento):
# CPF_HMAC_CHAVE=        # chave do HMAC-SHA256 do CPF (D-03)
# JWT_SEGREDO=           # assinatura dos tokens de login
# PAGAMENTO_CHAVE_API=   # gateway de pagamento
